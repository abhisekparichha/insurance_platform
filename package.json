{
  "name": "health-insurance-evaluator",
  "version": "0.1.0",
  "description": "Standardized health insurance schema and evaluation engine",
  "type": "module",
  "scripts": {
    "lint":         "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck":    "tsc --noEmit",
    "test":         "vitest run",
    "test:watch":   "vitest",
    "server":       "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "build:frontend": "cd frontend && pnpm install && pnpm build",
    "dev":          "concurrently --names API,UI --prefix-colors cyan,magenta \"pnpm server:watch\" \"cd frontend && pnpm dev\"",
    "start":        "node --import tsx/esm server/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
